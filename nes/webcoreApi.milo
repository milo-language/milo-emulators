// Browser-target NES core: the pure emulator (cpu+ppu+apu, zero FFI) plus the thin
// handle API the JS/canvas driver calls. Split out of webcore.milo so a native
// program can import it: webcore.milo carries the `main` the JS backend needs as an
// entry point, and Milo compiles every module into one namespace, so two modules
// cannot both define `main`.
from "./cpu" import {
    Cpu, Bus, newBus, newCpuReset, step, clockPpu, clockApu, serviceInterrupts
}
from "./ppu" import {
    renderFrame
}
from "./cartridge" import {
    Cartridge, parseCartridge
}

pub struct NesHandle {
    cpu: Cpu
    bus: Bus
}

// Build a 16 KiB all-NOP PRG bank with the reset vector pointing at $8000, used as
// a safe fallback when a ROM fails to parse so the driver never gets a null handle.
fn fallbackCart(): Cartridge {
    var prg: Vec<u8> = []
    var i: i64 = 0
    while i < 16384 {
        if i == 0x3FFC {
            prg.push(0x00 as u8)
        } else {
            if i == 0x3FFD {
                prg.push(0x80 as u8)
            } else {
                prg.push(0xEA as u8)
            }
        }
        i = i + 1
    }
    var chr: Vec<u8> = []
    i = 0
    while i < 8192 {
        chr.push(0 as u8)
        i = i + 1
    }
    return Cartridge {
        prg: prg, chr: chr, mapper: 0, mirrorVertical: false,
        hasBattery: false, prg16kBanks: 1, chr8kBanks: 1,
    }
}

// Parse `rom` (raw .nes bytes) and boot a fresh system. Never fails: a bad ROM
// falls back to the NOP cart above so the JS side always gets a usable handle.
pub fn createNes(rom: Vec<u8>): NesHandle {
    var cart = fallbackCart()
    match parseCartridge(rom) {
        Result.Ok(c) => {
            cart = c
        }
        Result.Err(e) => {
            print("ROM parse failed: " + e)
        }
    }
    var bus = newBus(cart)
    var cpu = newCpuReset(&mut bus)
    return NesHandle {
        cpu: cpu, bus: bus,
    }
}

// Latch controller-1 state. Bit layout (matches cpu.milo): 0 A, 1 B, 2 Select,
// 3 Start, 4 Up, 5 Down, 6 Left, 7 Right.
pub fn setButtons(h: &mut NesHandle, b: u8): void {
    h.bus.buttons = b
}

// Advance one video frame (CPU + PPU + APU), leaving the RGBA framebuffer in
// h.bus.ppu.fb for the driver to blit.
pub fn stepFrame(h: &mut NesHandle): void {
    let startFrame = h.bus.ppu.frame
    while h.bus.ppu.frame == startFrame {
        let before = h.cpu.cyc
        step(&mut h.cpu, &mut h.bus)
        let used = h.cpu.cyc - before
        var k: i64 = 0
        while k < used * 3 {
            clockPpu(&mut h.bus)
            k = k + 1
        }
        clockApu(&mut h.bus, used)
        serviceInterrupts(&mut h.cpu, &mut h.bus)
    }
    renderFrame(&mut h.bus.ppu)
}

// Single CPU instruction + its PPU/APU catch-up — for backend trace diffing.
pub fn stepOne(h: &mut NesHandle): void {
    let before = h.cpu.cyc
    step(&mut h.cpu, &mut h.bus)
    let used = h.cpu.cyc - before
    var k: i64 = 0
    while k < used * 3 {
        clockPpu(&mut h.bus)
        k = k + 1
    }
    clockApu(&mut h.bus, used)
    serviceInterrupts(&mut h.cpu, &mut h.bus)
}

