// Browser entry point for the NES core. All the actual API lives in webcoreApi.milo;
// this file exists to supply the `main` the JS backend appends a call to. Build:
//   bun run <milo>/src/main.ts emit-js nes/webcore.milo -o nes/web/nes-core.js
// The driver (web/index.html) does: createNes(romBytes) -> h; each rAF frame it
// calls setButtons(h, bits) then stepFrame(h), then blits h.bus.ppu.fb to a canvas.
from "./webcoreApi" import {
    NesHandle, createNes, setButtons, stepFrame, stepOne
}

// emit-js appends `main(); __flush();`; keep it a no-op so loading the module in
// the browser has no side effects — the driver drives everything.
fn main(): i32 {
    return 0
}
