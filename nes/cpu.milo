// MOS 6502 core (NES 2A03 variant — no decimal mode) + CPU memory bus.
// Cycle-accurate enough to match nestest.log register + cycle columns.
// Ref: https://www.nesdev.org/wiki/CPU, https://www.masswerk.at/6502/6502_instruction_set.html

from "./cartridge" import {
    Cartridge
}
from "./ppu" import {
    Ppu, newPpu, ppuRegRead, ppuRegWrite, mmc2InitMapper, mmc2SetChr
}
from "./apu" import {
    Apu, newApu, apuWrite, apuReadStatus, apuStep, dmcFill
}

// --- status flag bit masks (P register) ---
let FC: u8 = 0x01 // carry
let FZ: u8 = 0x02 // zero
let FI: u8 = 0x04 // interrupt disable
let FD: u8 = 0x08 // decimal (ignored on NES, still settable)
let FB: u8 = 0x10 // break (only in pushed copies)
let FU: u8 = 0x20 // unused, always 1
let FV: u8 = 0x40 // overflow
let FN: u8 = 0x80 // negative

// CPU-visible address space. Owns PRG-ROM and the PPU (which owns CHR/VRAM).
pub struct Bus {
    ram: [u8; 2048] // $0000-$07FF, mirrored through $1FFF
    wram: [u8; 8192] // $6000-$7FFF cartridge PRG-RAM (MMC3 scratch, etc.)
    prg: Vec<u8> // mapper-0 PRG, 16K or 32K
    prgMask: i64 // 0x3FFF (16K) or 0x7FFF (32K)
    ppu: Ppu
    apu: Apu
    ctrl1: u8 // $4016 controller-1 shift register (serial, drained LSB-first)
    strobe: u8 // $4016 strobe latch
    buttons: u8 // live controller-1 state: bit0 A,1 B,2 Select,3 Start,4 Up,5 Down,6 Left,7 Right
    ctrl2: u8 // $4017 controller-2 shift register (read side; $4017 writes are the APU frame counter)
    buttons2: u8 // live controller-2 state, same bit layout as `buttons`
    mapper: i64 // iNES mapper number (0 = NROM, 2 = UxROM, 4 = MMC3)
    prgBanks: i64 // number of 16 KiB PRG banks
    prgBank: i64 // UxROM: switchable 16 KiB bank mapped at $8000-$BFFF
    mmc2Prg: i64 // MMC2 (mapper 9): switchable 8 KiB bank at $8000-$9FFF
    m227Lo: i64 // mapper 227 (multicart): 16 KiB bank at $8000-$BFFF
    m227Hi: i64 // mapper 227: 16 KiB bank at $C000-$FFFF

    // MMC3 (mapper 4): 8 bank registers, PRG/CHR modes, and a scanline IRQ.
    mmcSelect: i64 // last $8000 (even) write: bank index (0-7) + mode bits 6/7
    mmcR0: i64
    mmcR1: i64
    mmcR2: i64
    mmcR3: i64
    mmcR4: i64
    mmcR5: i64
    mmcR6: i64
    mmcR7: i64
    irqLatch: i64
    irqCounter: i64
    irqReload: bool
    irqEnabled: bool
    irqPending: bool // set when the scanline counter hits 0; consumed by the CPU
    nmiArmed: bool // NMI edge detected last instruction, serviced this one (1-instr latency)
}

pub fn newBus(cart: Cartridge): Bus {
    let n = cart.prg.len
    // 16K carts mirror $C000-$FFFF onto $8000-$BFFF via a 0x3FFF mask.
    let mask: i64 = if n == 16384 {
        0x3FFF as i64
    } else {
        0x7FFF as i64
    }
    // Move CHR + mirroring into the PPU; PRG into the bus. (cart consumed.)
    let ppu = newPpu(cart.chr, cart.mirrorVertical)
    let banks = cart.prg16kBanks as i64
    var bus = Bus {
        ram: [0; 2048], wram: [0; 8192], prg: cart.prg, prgMask: mask, ppu: ppu, apu: newApu(), ctrl1: 0, strobe: 0, buttons: 0, ctrl2: 0, buttons2: 0,
        mapper: cart.mapper as i64, prgBanks: banks, prgBank: 0, mmc2Prg: 0, m227Lo: 0, m227Hi: 0,
        mmcSelect: 0, mmcR0: 0, mmcR1: 0, mmcR2: 0, mmcR3: 0, mmcR4: 0, mmcR5: 0, mmcR6: 0, mmcR7: 0,
        irqLatch: 0, irqCounter: 0, irqReload: false, irqEnabled: false, irqPending: false, nmiArmed: false
    }
    if bus.mapper == 4 {
        mmc3UpdateChr(&mut bus) // establish the initial CHR window mapping
    }
    if bus.mapper == 9 {
        mmc2InitMapper(&mut bus.ppu) // latch-driven CHR banking lives in the PPU
    }
    if bus.mapper == 227 {
        bus.m227Hi = 0 // boot the multicart menu (bank 0) at $C000
    }
    return bus
}

// One CPU read of the 16-bit address space, decoded to whichever device owns that range.
// `&mut` on a *read* is not an oversight: reading $2002/$2007/$4016 mutates the PPU's
// latch, its VRAM address, and the controller shift register respectively — the side
// effects games rely on. The `& 0x07FF` / `& 0x07` masks are the real hardware's address
// mirroring, not bounds checks.
fn busRead(bus: &mut Bus, addr: u16): u8 {
    let a: i64 = addr as i64
    if a < 0x2000 {
        return bus.ram[a & 0x07FF]
    }
    if a < 0x4000 {
        // $2000-$3FFF: 8 PPU registers, mirrored every 8 bytes
        return ppuRegRead(&mut bus.ppu, a & 0x07)
    }
    if a == 0x4016 {
        // controller 1: serial shift-out of the button state, LSB first.
        // While strobe is high the register is continuously reloaded from the
        // live state, so reads keep returning button A (bit 0).
        if (bus.strobe & 0x01) == 1 {
            bus.ctrl1 = bus.buttons
        }
        let bit = bus.ctrl1 & 0x01
        bus.ctrl1 = (bus.ctrl1 >> 1) | 0x80
        return bit | 0x40 // open-bus high bits read as 0x40 on real HW
    }
    if a == 0x4017 {
        // controller 2: same serial shift-out as $4016. (Writes to $4017 are the
        // APU frame counter, handled in busWrite — the read side is the pad.)
        if (bus.strobe & 0x01) == 1 {
            bus.ctrl2 = bus.buttons2
        }
        let bit = bus.ctrl2 & 0x01
        bus.ctrl2 = (bus.ctrl2 >> 1) | 0x80
        return bit | 0x40
    }
    if a == 0x4015 {
        return apuReadStatus(&mut bus.apu)
    }
    if a >= 0x6000 && a < 0x8000 {
        return bus.wram[a - 0x6000]
    }
    if a >= 0x8000 {
        if bus.mapper == 4 {
            return bus.prg[mmc3PrgOffset(bus, a)]
        }
        if bus.mapper == 9 {
            // MMC2: $8000-$9FFF switchable 8 KiB; $A000-$FFFF = fixed last three.
            let n8k = bus.prg.len / 0x2000
            if a < 0xA000 {
                return bus.prg[prgOffset(bus.prg, 0x2000, bus.mmc2Prg, a - 0x8000)]
            }
            if a < 0xC000 {
                return bus.prg[prgOffset(bus.prg, 0x2000, n8k - 3, a - 0xA000)]
            }
            if a < 0xE000 {
                return bus.prg[prgOffset(bus.prg, 0x2000, n8k - 2, a - 0xC000)]
            }
            return bus.prg[prgOffset(bus.prg, 0x2000, n8k - 1, a - 0xE000)]
        }
        if bus.mapper == 227 {
            if a < 0xC000 {
                return bus.prg[prgOffset(bus.prg, 0x4000, bus.m227Lo, a - 0x8000)]
            }
            return bus.prg[prgOffset(bus.prg, 0x4000, bus.m227Hi, a - 0xC000)]
        }
        if bus.mapper == 2 {
            // UxROM: $8000-$BFFF = switchable bank, $C000-$FFFF = fixed last bank.
            if a < 0xC000 {
                return bus.prg[prgOffset(bus.prg, 0x4000, bus.prgBank, a - 0x8000)]
            }
            return bus.prg[prgOffset(bus.prg, 0x4000, bus.prgBanks - 1, a - 0xC000)]
        }
        return bus.prg[(a - 0x8000) & bus.prgMask] // NROM
    }
    return 0
}

// One CPU write, decoded like busRead. Not a plain store: $4014 copies 256 bytes into PPU
// OAM inline (real hardware also stalls the CPU ~513 cycles for it; this emulator does
// not model that stall, which is why raster effects timed off DMA can drift).
fn busWrite(bus: &mut Bus, addr: u16, val: u8): void {
    let a: i64 = addr as i64
    if a < 0x2000 {
        bus.ram[a & 0x07FF] = val
        return
    }
    if a < 0x4000 {
        ppuRegWrite(&mut bus.ppu, a & 0x07, val)
        return
    }
    if a == 0x4014 {
        // OAMDMA: copy 256 bytes from CPU page $xx00 into PPU OAM
        let page = (val as i64) << 8
        var i: i64 = 0
        while i < 256 {
            let b = busRead(&mut bus, (page + i) as u16)
            ppuRegWrite(&mut bus.ppu, 4, b) // write through OAMDATA (advances oamAddr)
            i = i + 1
        }
        return
    }
    if a == 0x4016 {
        bus.strobe = val & 0x01
        // Strobe going (or held) high latches both controller ports for shift-out.
        if bus.strobe == 1 {
            bus.ctrl1 = bus.buttons
            bus.ctrl2 = bus.buttons2
        }
        return
    }
    // APU + frame counter: $4000-$4013, $4015, $4017 ($4014/$4016 handled above).
    if a >= 0x4000 && a <= 0x4017 {
        apuWrite(&mut bus.apu, a - 0x4000, val)
        return
    }
    if a >= 0x6000 && a < 0x8000 {
        bus.wram[a - 0x6000] = val
        return
    }
    if a >= 0x8000 {
        // UxROM bank select: low bits pick the 16 KiB bank at $8000-$BFFF.
        if bus.mapper == 2 {
            bus.prgBank = (val as i64) & (bus.prgBanks - 1)
            return
        }
        if bus.mapper == 4 {
            mmc3Write(&mut bus, a, val)
            return
        }
        if bus.mapper == 9 {
            // MMC2 registers (only $A000-$FFFF; $8000-$9FFF is unmapped).
            if a < 0xA000 {
                return
            }
            if a < 0xB000 {
                bus.mmc2Prg = (val as i64) & 0x0F // PRG select
            } else if a < 0xC000 {
                mmc2SetChr(&mut bus.ppu, 0, (val as i64) & 0x1F) // CHR $0xxx / FD
            } else if a < 0xD000 {
                mmc2SetChr(&mut bus.ppu, 1, (val as i64) & 0x1F) // CHR $0xxx / FE
            } else if a < 0xE000 {
                mmc2SetChr(&mut bus.ppu, 2, (val as i64) & 0x1F) // CHR $1xxx / FD
            } else if a < 0xF000 {
                mmc2SetChr(&mut bus.ppu, 3, (val as i64) & 0x1F) // CHR $1xxx / FE
            } else {
                bus.ppu.mirrorVertical = (val & 1) == 0 // $F000: 0=vert,1=horiz
            }
            return
        }
        if bus.mapper == 227 {
            mapper227Write(&mut bus, a)
            return
        }
        return
    }
    // other APU/IO writes ignored until modeled
}

// Mapper 227 (multicart, e.g. 1200-in-1): the *write address* is the register.
// Address bits (nesdev): A2-A6 = 16 KiB PRG bank, A7 = L mode, A1 = mirroring,
// A0 = S. L=1 is NROM: S=1 -> 32 KiB at $8000-$FFFF, S=0 -> the 16 KiB bank
// MIRRORED into both $8000 and $C000 (so the selected game's reset vector at
// $FFFC comes from *its* bank — the previous code fixed $C000 to the menu, so
// launching a game bounced straight back to the menu). L=0 is UNROM-like:
// switchable $8000, $C000 fixed to inner bank 0 (or 7 when S=1).
fn mapper227Write(bus: &mut Bus, a: i64): void {
    let bank = (a >> 2) & 0x1F
    let l = (a >> 7) & 1
    let s = a & 1 // PRG A14 source: 0 = follows CPU A14 (32K contiguous), 1 = fixed (16K mirror)
    let mirror = (a >> 1) & 1
    if l == 1 {
        if s == 0 {
            // 32 KiB (NROM-256): consecutive banks at $8000 and $C000.
            bus.m227Lo = bank & 0x1E
            bus.m227Hi = (bank & 0x1E) | 1
        } else {
            // 16 KiB (NROM-128): the bank mirrored into both windows.
            bus.m227Lo = bank
            bus.m227Hi = bank
        }
    } else {
        bus.m227Lo = bank
        bus.m227Hi = (bank & 0x18) | (if s == 1 {
            7
        } else {
            0
        }
        )
    }
    bus.ppu.mirrorVertical = mirror == 0
}

// MMC3 register file: even/odd address within each $2000 block selects the pair.
fn mmc3Write(bus: &mut Bus, a: i64, val: u8): void {
    let even = (a & 1) == 0
    let v = val as i64
    if a < 0xA000 {
        if even {
            bus.mmcSelect = v // bank select + PRG/CHR mode bits
        } else {
            let r = bus.mmcSelect & 7 // bank data -> selected register
            if r == 0 {
                bus.mmcR0 = v
            }
            if r == 1 {
                bus.mmcR1 = v
            }
            if r == 2 {
                bus.mmcR2 = v
            }
            if r == 3 {
                bus.mmcR3 = v
            }
            if r == 4 {
                bus.mmcR4 = v
            }
            if r == 5 {
                bus.mmcR5 = v
            }
            if r == 6 {
                bus.mmcR6 = v
            }
            if r == 7 {
                bus.mmcR7 = v
            }
            mmc3UpdateChr(&mut bus)
        }
    } else if a < 0xC000 {
        if even {
            bus.ppu.mirrorVertical = (v & 1) == 0 // $A000 bit0: 0=vertical,1=horizontal
        }
        // odd ($A001): PRG-RAM protect — unmodeled
    } else if a < 0xE000 {
        if even {
            bus.irqLatch = v // $C000: IRQ reload value
        } else {
            bus.irqReload = true // $C001: reload on next clock
        }
    } else {
        if even {
            bus.irqEnabled = false // $E000: disable + acknowledge
            bus.irqPending = false
        } else {
            bus.irqEnabled = true // $E001: enable
        }
    }
}

pub struct Cpu {
    a: u8 // accumulator — the only register ALU results land in
    x: u8 // index register; also the only one that can index the stack (TXS/TSX)
    y: u8 // index register; no stack access, but the only one for (zp),Y
    sp: u8 // stack pointer, an offset into page $0100 — see push8/pop8
    p: u8 // status flags, masks FC..FN above (NV-BDIZC)
    pc: u16
    cyc: i64 // total elapsed CPU cycles
    extraCycles: i64 // page-cross / branch penalties accumulated this instr
    unknownSeen: [bool; 256] // one-shot log guard: bit set the first time an opcode falls through
}

// nestest's automated entry: PC=$C000, SP=$FD, P=$24 (I+U), 7 cycles already burned.
pub fn newCpuNestest(): Cpu {
    return Cpu {
        a: 0, x: 0, y: 0, sp: 0xFD, p: 0x24, pc: 0xC000, cyc: 7, extraCycles: 0, unknownSeen: [false; 256]
    }
}

// Power-on / reset: PC from the reset vector at $FFFC/$FFFD.
pub fn newCpuReset(bus: &mut Bus): Cpu {
    let lo = busRead(&mut bus, 0xFFFC) as i64
    let hi = busRead(&mut bus, 0xFFFD) as i64
    return Cpu {
        a: 0, x: 0, y: 0, sp: 0xFD, p: 0x24, pc: wrap16(lo | (hi << 8)), cyc: 0, extraCycles: 0, unknownSeen: [false; 256]
    }
}

// Non-maskable interrupt (PPU vblank): push PC + P, jump to $FFFA vector.
fn nmi(cpu: &mut Cpu, bus: &mut Bus): void {
    push16(&mut cpu, &mut bus, cpu.pc)
    push8(&mut cpu, &mut bus, (cpu.p & (~FB)) | FU)
    setFlag(&mut cpu, FI, true)
    let lo = busRead(&mut bus, 0xFFFA) as i64
    let hi = busRead(&mut bus, 0xFFFB) as i64
    cpu.pc = wrap16(lo | (hi << 8))
    cpu.cyc = cpu.cyc + 7
}

// Maskable interrupt (MMC3 scanline IRQ): like nmi but gated on the I flag,
// vectored through $FFFE. The caller checks I; this always takes the interrupt.
fn irq(cpu: &mut Cpu, bus: &mut Bus): void {
    push16(&mut cpu, &mut bus, cpu.pc)
    push8(&mut cpu, &mut bus, (cpu.p & (~FB)) | FU)
    setFlag(&mut cpu, FI, true)
    let lo = busRead(&mut bus, 0xFFFE) as i64
    let hi = busRead(&mut bus, 0xFFFF) as i64
    cpu.pc = wrap16(lo | (hi << 8))
    cpu.cyc = cpu.cyc + 7
}

// Service pending interrupts after one CPU instruction + its PPU/APU catch-up.
// NMI carries a one-instruction recognition latency: the 6502 polls the
// interrupt lines late in each instruction, so an NMI asserted as the PPU enters
// vblank isn't serviced until AFTER the next instruction completes. That gap lets
// a mainline "wait for vblank" poll (LDA $2002 / BPL) observe bit 7 before the NMI
// handler's own $2002 read clears it. Dispatching NMI immediately preempted that
// poll, so vblank-wait loops with NMI enabled spun forever — the 1200-in-1
// BOMBERMAN title->play handoff (loop at $C288) is the canonical repro.
pub fn serviceInterrupts(cpu: &mut Cpu, bus: &mut Bus): void {
    if bus.nmiArmed {
        bus.nmiArmed = false
        nmi(&mut cpu, &mut bus)
    } else if bus.ppu.nmiPending {
        bus.ppu.nmiPending = false
        bus.nmiArmed = true
    }
    // APU frame IRQ + DMC IRQ are level-triggered: OR them into the line at check
    // time rather than latching bus.irqPending (which is MMC3's edge latch —
    // latching there leaves a phantom pending IRQ after the game acks, desyncing
    // MMC3 scanline splits).
    if (bus.irqPending || bus.apu.frameIrq || bus.apu.dmc.irqFlag) && !cpuFlag(cpu, 0x04) {
        bus.irqPending = false
        irq(&mut cpu, &mut bus)
    }
}

// --- MMC3 (mapper 4) ---

// Recompute the eight 1 KiB CHR window offsets from R0-R5 and the CHR mode bit.
fn mmc3UpdateChr(bus: &mut Bus): void {
    let num1k = bus.ppu.chr.len / 0x400
    let mode = (bus.mmcSelect >> 7) & 1
    var w0: i64 = 0
    var w1: i64 = 0
    var w2: i64 = 0
    var w3: i64 = 0
    var w4: i64 = 0
    var w5: i64 = 0
    var w6: i64 = 0
    var w7: i64 = 0
    if mode == 0 {
        // $0000=R0(2K) $0800=R1(2K) $1000=R2 $1400=R3 $1800=R4 $1C00=R5 (1K)
        w0 = bus.mmcR0 & 0xFE
        w1 = (bus.mmcR0 & 0xFE) + 1
        w2 = bus.mmcR1 & 0xFE
        w3 = (bus.mmcR1 & 0xFE) + 1
        w4 = bus.mmcR2
        w5 = bus.mmcR3
        w6 = bus.mmcR4
        w7 = bus.mmcR5
    } else {
        // $0000=R2 $0400=R3 $0800=R4 $0C00=R5 (1K) $1000=R0(2K) $1800=R1(2K)
        w0 = bus.mmcR2
        w1 = bus.mmcR3
        w2 = bus.mmcR4
        w3 = bus.mmcR5
        w4 = bus.mmcR0 & 0xFE
        w5 = (bus.mmcR0 & 0xFE) + 1
        w6 = bus.mmcR1 & 0xFE
        w7 = (bus.mmcR1 & 0xFE) + 1
    }
    bus.ppu.chrBankOffset[0] = (w0 % num1k) * 0x400
    bus.ppu.chrBankOffset[1] = (w1 % num1k) * 0x400
    bus.ppu.chrBankOffset[2] = (w2 % num1k) * 0x400
    bus.ppu.chrBankOffset[3] = (w3 % num1k) * 0x400
    bus.ppu.chrBankOffset[4] = (w4 % num1k) * 0x400
    bus.ppu.chrBankOffset[5] = (w5 % num1k) * 0x400
    bus.ppu.chrBankOffset[6] = (w6 % num1k) * 0x400
    bus.ppu.chrBankOffset[7] = (w7 % num1k) * 0x400
}

// Byte offset into PRG for a $8000-$FFFF address under the current PRG mode.
// Windows: two switchable (R6,R7) and two fixed (second-last, last 8 KiB bank).
// Resolve a mapper bank index + intra-bank byte into a byte offset into `prg`,
// wrapping the (untrusted, register-derived) bank number into the ROM's real
// bank count. The nonneg double-modulo also absorbs the negative results of
// fixed-bank math like `n8k - 3` on a ROM with fewer banks than a mapper's
// fixed region assumes, so a malformed cart can never index past the buffer.
// `bank` may be any i64; `off` must be an intra-bank byte (0..bankSize).
fn prgOffset(prg: &Vec<u8>, bankSize: i64, bank: i64, off: i64): i64
requires bankSize > 0 && bankSize <= prg.len && off >= 0 && off < bankSize
ensures result >= 0 && result < prg.len
{
    let n = prg.len / bankSize
    let b = ((bank % n) + n) % n
    return b * bankSize + off
}

fn mmc3PrgOffset(bus: &Bus, a: i64): i64 {
    let num8k = bus.prg.len / 0x2000
    let last = num8k - 1
    let mode = (bus.mmcSelect >> 6) & 1
    var bank: i64 = 0
    if a < 0xA000 {
        bank = if mode == 0 {
            bus.mmcR6
        } else {
            last - 1
        }
    } else if a < 0xC000 {
        bank = bus.mmcR7
    } else if a < 0xE000 {
        bank = if mode == 0 {
            last - 1
        } else {
            bus.mmcR6
        }
    } else {
        bank = last
    }
    return prgOffset(bus.prg, 0x2000, bank, a & 0x1FFF)
}

// Clock the scanline IRQ counter once per rendered scanline (A12 approximation).
fn mmc3ClockIrq(bus: &mut Bus): void {
    if bus.irqCounter == 0 || bus.irqReload {
        bus.irqCounter = bus.irqLatch
        bus.irqReload = false
    } else {
        bus.irqCounter = bus.irqCounter - 1
    }
    if bus.irqCounter == 0 && bus.irqEnabled {
        bus.irqPending = true
    }
}

// Advance the PPU one dot and, for MMC3, clock its scanline IRQ at a fixed dot
// of each visible line while rendering is enabled.
// Advance the APU by `cycles` CPU cycles, then service any DMC sample-fetch it
// requested (the DMC reads CPU memory, which only the bus can do).
pub fn clockApu(bus: &mut Bus, cycles: i64): void {
    apuStep(&mut bus.apu, cycles)
    if bus.apu.dmc.needsFetch {
        let addr = bus.apu.dmc.curAddr
        let b = busRead(&mut bus, addr as u16)
        dmcFill(&mut bus.apu.dmc, b as i64)
    }
}

pub fn clockPpu(bus: &mut Bus): void {
    ppuStep(&mut bus.ppu)
    if bus.mapper == 4 && bus.ppu.dot == 260 && bus.ppu.scanline < 240 && (bus.ppu.mask & 0x18) != 0 {
        mmc3ClockIrq(&mut bus)
    }
}

// --- flag helpers ---
fn cpuFlag(cpu: &Cpu, mask: u8): bool {
    return (cpu.p & mask) != 0
}

fn setFlag(cpu: &mut Cpu, mask: u8, on: bool): void {
    if on {
        cpu.p = cpu.p | mask
    } else {
        cpu.p = cpu.p & (~mask)
    }
}

fn setZN(cpu: &mut Cpu, v: u8): void {
    setFlag(&mut cpu, FZ, v == 0)
    setFlag(&mut cpu, FN, (v & 0x80) != 0)
}

// --- 16-bit / pc helpers (explicit masking NES arithmetic wraps) ---
fn wrap16(v: i64): u16
ensures(result as i64) == (v & 0xFFFF)
{
    return (v & 0xFFFF) as u16
}

fn read16(bus: &mut Bus, addr: u16): u16 {
    let lo: i64 = busRead(&mut bus, addr) as i64
    let hi: i64 = busRead(&mut bus, wrap16((addr as i64) + 1)) as i64
    return wrap16(lo | (hi << 8))
}

// 6502 indirect-JMP page-wrap bug: high byte reads from ($xxFF & $xx00), not +1 page.
fn read16Bug(bus: &mut Bus, addr: u16): u16 {
    let a: i64 = addr as i64
    let lo: i64 = busRead(&mut bus, addr) as i64
    let hiAddr: i64 = (a & 0xFF00) | ((a + 1) & 0x00FF)
    let hi: i64 = busRead(&mut bus, wrap16(hiAddr)) as i64
    return wrap16(lo | (hi << 8))
}

fn fetch8(cpu: &mut Cpu, bus: &mut Bus): u8 {
    let v = busRead(&mut bus, cpu.pc)
    cpu.pc = wrap16((cpu.pc as i64) + 1)
    return v
}

fn fetch16(cpu: &mut Cpu, bus: &mut Bus): u16 {
    let v = read16(&mut bus, cpu.pc)
    cpu.pc = wrap16((cpu.pc as i64) + 2)
    return v
}

// --- stack ($0100-$01FF) ---
fn push8(cpu: &mut Cpu, bus: &mut Bus, v: u8): void {
    busWrite(&mut bus, wrap16(0x0100 | (cpu.sp as i64)), v)
    cpu.sp = cpu.sp.wrappingSub(1)
}

fn pop8(cpu: &mut Cpu, bus: &mut Bus): u8 {
    cpu.sp = cpu.sp.wrappingAdd(1)
    return busRead(&mut bus, wrap16(0x0100 | (cpu.sp as i64)))
}

fn push16(cpu: &mut Cpu, bus: &mut Bus, v: u16): void {
    push8(&mut cpu, &mut bus, (v >> 8) as u8) // high byte — genuine u16→u8 narrowing
    push8(&mut cpu, &mut bus, v as u8)
}

fn pop16(cpu: &mut Cpu, bus: &mut Bus): u16 {
    let lo: i64 = pop8(&mut cpu, &mut bus) as i64
    let hi: i64 = pop8(&mut cpu, &mut bus) as i64
    return wrap16(lo | (hi << 8))
}

// Did adding an index cross a page boundary? (+1 cycle for read-index modes.)
fn pageCrossed(base: u16, eff: u16): bool {
    return ((base as i64) & 0xFF00) != ((eff as i64) & 0xFF00)
}

// --- addressing-mode resolvers: advance PC past operand, return effective addr.
// Indexed read modes stash a page-cross penalty in cpu.extraCycles only the
// read opcodes honor it (stores/RMW take fixed cycles).
fn read16ZP(bus: &mut Bus, z: i64): u16
requires 0 <= z && z <= 255 // zero-page pointer index; callers must pre-mask
{
    let lo: i64 = busRead(&mut bus, (z & 0xFF) as u16) as i64
    let hi: i64 = busRead(&mut bus, ((z + 1) & 0xFF) as u16) as i64
    return wrap16(lo | (hi << 8))
}

fn aImm(cpu: &mut Cpu): u16 {
    let a = cpu.pc
    cpu.pc = wrap16((cpu.pc as i64) + 1)
    return a
}

fn aZp(cpu: &mut Cpu, bus: &mut Bus): u16 {
    return fetch8(&mut cpu, &mut bus) as u16
}

fn aZpX(cpu: &mut Cpu, bus: &mut Bus): u16 {
    return (((fetch8(&mut cpu, &mut bus) as i64) + (cpu.x as i64)) & 0xFF) as u16
}

fn aZpY(cpu: &mut Cpu, bus: &mut Bus): u16 {
    return (((fetch8(&mut cpu, &mut bus) as i64) + (cpu.y as i64)) & 0xFF) as u16
}

fn aAbs(cpu: &mut Cpu, bus: &mut Bus): u16 {
    return fetch16(&mut cpu, &mut bus)
}

fn aAbsX(cpu: &mut Cpu, bus: &mut Bus): u16 {
    let base = fetch16(&mut cpu, &mut bus)
    let eff = wrap16((base as i64) + (cpu.x as i64))
    if pageCrossed(base, eff) {
        cpu.extraCycles = 1
    }
    return eff
}

fn aAbsY(cpu: &mut Cpu, bus: &mut Bus): u16 {
    let base = fetch16(&mut cpu, &mut bus)
    let eff = wrap16((base as i64) + (cpu.y as i64))
    if pageCrossed(base, eff) {
        cpu.extraCycles = 1
    }
    return eff
}

fn aIndX(cpu: &mut Cpu, bus: &mut Bus): u16 {
    let z = ((fetch8(&mut cpu, &mut bus) as i64) + (cpu.x as i64)) & 0xFF
    return read16ZP(&mut bus, z)
}

fn aIndY(cpu: &mut Cpu, bus: &mut Bus): u16 {
    let z = fetch8(&mut cpu, &mut bus) as i64
    let base = read16ZP(&mut bus, z)
    let eff = wrap16((base as i64) + (cpu.y as i64))
    if pageCrossed(base, eff) {
        cpu.extraCycles = 1
    }
    return eff
}

// --- ALU primitives ---
fn adc(cpu: &mut Cpu, m: u8): void {
    let a: i64 = cpu.a as i64
    let carry: i64 = if cpuFlag(cpu, FC) {
        1 as i64
    } else {
        0 as i64
    }
    let sum: i64 = a + (m as i64) + carry
    let r: u8 = (sum & 0xFF) as u8
    setFlag(&mut cpu, FC, sum > 0xFF)
    // overflow: operands share sign, result differs
    setFlag(&mut cpu, FV, ((~(a ^ (m as i64))) & (a ^ (r as i64)) & 0x80) != 0)
    cpu.a = r
    setZN(&mut cpu, r)
}

fn sbc(cpu: &mut Cpu, m: u8): void {
    adc(&mut cpu, (m as i64 ^ 0xFF) as u8)
}

fn compare(cpu: &mut Cpu, reg: u8, m: u8): void {
    setFlag(&mut cpu, FC, reg >= m)
    setZN(&mut cpu, reg.wrappingSub(m)) // only the low byte feeds Z/N
}

fn bitTest(cpu: &mut Cpu, m: u8): void {
    setFlag(&mut cpu, FZ, ((cpu.a as i64) & (m as i64)) == 0)
    setFlag(&mut cpu, FN, (m & 0x80) != 0)
    setFlag(&mut cpu, FV, (m & 0x40) != 0)
}

// shifts/rotates return the result and set C from the shifted-out bit.
fn aslV(cpu: &mut Cpu, m: u8): u8 {
    setFlag(&mut cpu, FC, (m & 0x80) != 0)
    let r: u8 = m << 1 // u8 shift truncates the carried-out bit
    setZN(&mut cpu, r)
    return r
}

fn lsrV(cpu: &mut Cpu, m: u8): u8 {
    setFlag(&mut cpu, FC, (m & 0x01) != 0)
    let r: u8 = m >> 1
    setZN(&mut cpu, r)
    return r
}

fn rolV(cpu: &mut Cpu, m: u8): u8 {
    let cin: u8 = if cpuFlag(cpu, FC) {
        1
    } else {
        0
    }
    setFlag(&mut cpu, FC, (m & 0x80) != 0)
    let r: u8 = (m << 1) | cin
    setZN(&mut cpu, r)
    return r
}

fn rorV(cpu: &mut Cpu, m: u8): u8 {
    let cin: u8 = if cpuFlag(cpu, FC) {
        0x80
    } else {
        0
    }
    setFlag(&mut cpu, FC, (m & 0x01) != 0)
    let r: u8 = (m >> 1) | cin
    setZN(&mut cpu, r)
    return r
}

// Conditional branch with taken/page-cross cycle penalties base 2 added by caller.
fn branch(cpu: &mut Cpu, bus: &mut Bus, cond: bool): void {
    var off: i64 = fetch8(&mut cpu, &mut bus) as i64
    if off >= 128 {
        off = off - 256
    }
    if cond {
        let pcNow = cpu.pc
        let target = wrap16((cpu.pc as i64) + off)
        cpu.cyc = cpu.cyc + 1
        if pageCrossed(pcNow, target) {
            cpu.cyc = cpu.cyc + 1
        }
        cpu.pc = target
    }
}

// --- trace formatting (self-contained strconv lacks decimal int->string) ---
fn appendStr(dst: &mut string, src: &string): void {
    for b in src {
        dst.push(b)
    }
}

fn hex2(v: i64): string {
    let d = "0123456789ABCDEF"
    var s = ""
    s.push(d[(v >> 4) & 0xF])
    s.push(d[v & 0xF])
    return s
}

pub fn hex4(v: i64): string {
    var s = hex2((v >> 8) & 0xFF)
    let lo = hex2(v & 0xFF)
    appendStr(&mut s, lo)
    return s
}

fn decStr(n: i64): string {
    if n == 0 {
        return "0"
    }
    var v = n
    var buf = ""
    while v > 0 {
        buf.push(((v % 10) + 48) as u8)
        v = v / 10
    }
    var out = ""
    var i: i64 = buf.len - 1
    while i >= 0 {
        out.push(buf[i])
        i = i - 1
    }
    return out
}

// nestest.log comparison columns: "PC A:.. X:.. Y:.. P:.. SP:.. CYC:.."
pub fn formatState(cpu: &Cpu): string {
    var s = hex4(cpu.pc as i64)
    let a = hex2(cpu.a as i64)
    appendStr(&mut s, " A:")
    appendStr(&mut s, a)
    let x = hex2(cpu.x as i64)
    appendStr(&mut s, " X:")
    appendStr(&mut s, x)
    let y = hex2(cpu.y as i64)
    appendStr(&mut s, " Y:")
    appendStr(&mut s, y)
    let p = hex2(cpu.p as i64)
    appendStr(&mut s, " P:")
    appendStr(&mut s, p)
    let sp = hex2(cpu.sp as i64)
    appendStr(&mut s, " SP:")
    appendStr(&mut s, sp)
    let c = decStr(cpu.cyc)
    appendStr(&mut s, " CYC:")
    appendStr(&mut s, c)
    return s
}

// --- unofficial ("illegal") opcode helpers, addr pre-resolved by caller ---
fn lax(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let v = busRead(&mut bus, addr)
    cpu.a = v
    cpu.x = v
    setZN(&mut cpu, v)
}

fn sax(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    busWrite(&mut bus, addr, cpu.a & cpu.x)
}

fn dcp(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let m = busRead(&mut bus, addr).wrappingSub(1)
    busWrite(&mut bus, addr, m)
    compare(&mut cpu, cpu.a, m)
}

fn isb(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let m = busRead(&mut bus, addr).wrappingAdd(1)
    busWrite(&mut bus, addr, m)
    sbc(&mut cpu, m)
}

fn slo(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let m = aslV(&mut cpu, busRead(&mut bus, addr))
    busWrite(&mut bus, addr, m)
    cpu.a = cpu.a | m
    setZN(&mut cpu, cpu.a)
}

fn rla(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let m = rolV(&mut cpu, busRead(&mut bus, addr))
    busWrite(&mut bus, addr, m)
    cpu.a = cpu.a & m
    setZN(&mut cpu, cpu.a)
}

fn sre(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let m = lsrV(&mut cpu, busRead(&mut bus, addr))
    busWrite(&mut bus, addr, m)
    cpu.a = cpu.a ^ m
    setZN(&mut cpu, cpu.a)
}

fn rra(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let m = rorV(&mut cpu, busRead(&mut bus, addr))
    busWrite(&mut bus, addr, m)
    adc(&mut cpu, m)
}

// ANC: A &= imm; carry is copied from the result's bit 7 (as ASL/ROL would).
fn anc(cpu: &mut Cpu, m: u8): void {
    cpu.a = cpu.a & m
    setZN(&mut cpu, cpu.a)
    setFlag(&mut cpu, FC, (cpu.a & 0x80) != 0)
}

// ALR (ASR): A &= imm, then LSR A.
fn alr(cpu: &mut Cpu, m: u8): void {
    cpu.a = lsrV(&mut cpu, cpu.a & m)
}

// ARR: A &= imm, then ROR A — but C/V come from the result, not the shifted bit.
fn arr(cpu: &mut Cpu, m: u8): void {
    let cin: u8 = if cpuFlag(cpu, FC) {
        0x80
    } else {
        0
    }
    let r: u8 = ((cpu.a & m) >> 1) | cin
    cpu.a = r
    setZN(&mut cpu, r) // N = old carry (now bit 7), Z from r
    setFlag(&mut cpu, FC, (r & 0x40) != 0)
    setFlag(&mut cpu, FV, ((((r as i64) >> 6) ^ ((r as i64) >> 5)) & 1) != 0)
}

// SBX (AXS): X = (A & X) - imm; carry set like CMP, no borrow-in.
fn sbx(cpu: &mut Cpu, m: u8): void {
    let ax: i64 = (cpu.a as i64) & (cpu.x as i64)
    setFlag(&mut cpu, FC, ax >= (m as i64))
    cpu.x = ((ax - (m as i64)) & 0xFF) as u8
    setZN(&mut cpu, cpu.x)
}

// LAS: A = X = SP = (mem & SP).
fn las(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    let t = busRead(&mut bus, addr) & cpu.sp
    cpu.a = t
    cpu.x = t
    cpu.sp = t
    setZN(&mut cpu, t)
}

// LXA: A = X = imm. (The chip's "magic constant" varies; 0xFF is the stable
// value most emulators/test ROMs assume, reducing this to LDA #imm; TAX.)
fn lxa(cpu: &mut Cpu, m: u8): void {
    cpu.a = m
    cpu.x = m
    setZN(&mut cpu, m)
}

// ANE (XAA): A = (A | magic) & X & imm. Unstable; 0xEE is the common magic.
fn ane(cpu: &mut Cpu, m: u8): void {
    cpu.a = (cpu.a | 0xEE) & cpu.x & m
    setZN(&mut cpu, cpu.a)
}

// SHA/SHX/SHY/TAS: store reg AND'd with (high byte of target + 1) — the address
// high byte leaks onto the data bus on these unstable stores. Games only hit
// these when already derailed, so the simple (non-page-cross-corrupting) form.
fn hiPlus1(addr: u16): i64 {
    return (((addr as i64) >> 8) + 1) & 0xFF
}

fn sha(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    busWrite(&mut bus, addr, (((cpu.a as i64) & (cpu.x as i64) & hiPlus1(addr)) & 0xFF) as u8)
}

fn shx(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    busWrite(&mut bus, addr, (((cpu.x as i64) & hiPlus1(addr)) & 0xFF) as u8)
}

fn shy(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    busWrite(&mut bus, addr, (((cpu.y as i64) & hiPlus1(addr)) & 0xFF) as u8)
}

fn tas(cpu: &mut Cpu, bus: &mut Bus, addr: u16): void {
    cpu.sp = cpu.a & cpu.x
    busWrite(&mut bus, addr, (((cpu.sp as i64) & hiPlus1(addr)) & 0xFF) as u8)
}

// JAM/KIL: hardware halts until reset. Rewind PC onto the opcode so it re-executes
// forever (frozen mainline), but still burn cycles so the caller's PPU catch-up +
// NMI keep running — the emulator stays responsive instead of hanging.
fn jam(cpu: &mut Cpu): void {
    cpu.pc = wrap16((cpu.pc as i64) - 1)
    cpu.cyc = cpu.cyc + 2
}

// Execute one instruction, advancing cyc by its total cost.
pub fn step(cpu: &mut Cpu, bus: &mut Bus): void {
    cpu.extraCycles = 0
    let op = fetch8(&mut cpu, &mut bus)
    match op {
        // ---- BRK ---- software interrupt; 2-byte (opcode + ignored padding).
        // fetch8 left PC at the padding byte, so push PC+1 to skip it on RTI.
        0x00 => {
            push16(&mut cpu, &mut bus, wrap16(cpu.pc as i64 + 1))
            push8(&mut cpu, &mut bus, cpu.p | FB | FU)
            setFlag(&mut cpu, FI, true)
            let lo = busRead(&mut bus, 0xFFFE) as i64
            let hi = busRead(&mut bus, 0xFFFF) as i64
            cpu.pc = wrap16(lo | (hi << 8))
            cpu.cyc = cpu.cyc + 7
        }
        // ---- LDA ----
        0xA9 => {
            let v = busRead(&mut bus, aImm(&mut cpu))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 2
        }
        0xA5 => {
            let v = busRead(&mut bus, aZp(&mut cpu, &mut bus))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 3
        }
        0xB5 => {
            let v = busRead(&mut bus, aZpX(&mut cpu, &mut bus))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4
        }
        0xAD => {
            let v = busRead(&mut bus, aAbs(&mut cpu, &mut bus))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4
        }
        0xBD => {
            let v = busRead(&mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        0xB9 => {
            let v = busRead(&mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        0xA1 => {
            let v = busRead(&mut bus, aIndX(&mut cpu, &mut bus))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 6
        }
        0xB1 => {
            let v = busRead(&mut bus, aIndY(&mut cpu, &mut bus))
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 5 + cpu.extraCycles
        }
        // ---- LDX ----
        0xA2 => {
            let v = busRead(&mut bus, aImm(&mut cpu))
            cpu.x = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 2
        }
        0xA6 => {
            let v = busRead(&mut bus, aZp(&mut cpu, &mut bus))
            cpu.x = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 3
        }
        0xB6 => {
            let v = busRead(&mut bus, aZpY(&mut cpu, &mut bus))
            cpu.x = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4
        }
        0xAE => {
            let v = busRead(&mut bus, aAbs(&mut cpu, &mut bus))
            cpu.x = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4
        }
        0xBE => {
            let v = busRead(&mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.x = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        // ---- LDY ----
        0xA0 => {
            let v = busRead(&mut bus, aImm(&mut cpu))
            cpu.y = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 2
        }
        0xA4 => {
            let v = busRead(&mut bus, aZp(&mut cpu, &mut bus))
            cpu.y = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 3
        }
        0xB4 => {
            let v = busRead(&mut bus, aZpX(&mut cpu, &mut bus))
            cpu.y = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4
        }
        0xAC => {
            let v = busRead(&mut bus, aAbs(&mut cpu, &mut bus))
            cpu.y = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4
        }
        0xBC => {
            let v = busRead(&mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.y = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        // ---- STA ----
        0x85 => {
            busWrite(&mut bus, aZp(&mut cpu, &mut bus), cpu.a)
            cpu.cyc = cpu.cyc + 3
        }
        0x95 => {
            busWrite(&mut bus, aZpX(&mut cpu, &mut bus), cpu.a)
            cpu.cyc = cpu.cyc + 4
        }
        0x8D => {
            busWrite(&mut bus, aAbs(&mut cpu, &mut bus), cpu.a)
            cpu.cyc = cpu.cyc + 4
        }
        0x9D => {
            busWrite(&mut bus, aAbsX(&mut cpu, &mut bus), cpu.a)
            cpu.cyc = cpu.cyc + 5
        }
        0x99 => {
            busWrite(&mut bus, aAbsY(&mut cpu, &mut bus), cpu.a)
            cpu.cyc = cpu.cyc + 5
        }
        0x81 => {
            busWrite(&mut bus, aIndX(&mut cpu, &mut bus), cpu.a)
            cpu.cyc = cpu.cyc + 6
        }
        0x91 => {
            busWrite(&mut bus, aIndY(&mut cpu, &mut bus), cpu.a)
            cpu.cyc = cpu.cyc + 6
        }
        // ---- STX / STY ----
        0x86 => {
            busWrite(&mut bus, aZp(&mut cpu, &mut bus), cpu.x)
            cpu.cyc = cpu.cyc + 3
        }
        0x96 => {
            busWrite(&mut bus, aZpY(&mut cpu, &mut bus), cpu.x)
            cpu.cyc = cpu.cyc + 4
        }
        0x8E => {
            busWrite(&mut bus, aAbs(&mut cpu, &mut bus), cpu.x)
            cpu.cyc = cpu.cyc + 4
        }
        0x84 => {
            busWrite(&mut bus, aZp(&mut cpu, &mut bus), cpu.y)
            cpu.cyc = cpu.cyc + 3
        }
        0x94 => {
            busWrite(&mut bus, aZpX(&mut cpu, &mut bus), cpu.y)
            cpu.cyc = cpu.cyc + 4
        }
        0x8C => {
            busWrite(&mut bus, aAbs(&mut cpu, &mut bus), cpu.y)
            cpu.cyc = cpu.cyc + 4
        }
        // ---- transfers ----
        0xAA => {
            cpu.x = cpu.a
            setZN(&mut cpu, cpu.x)
            cpu.cyc = cpu.cyc + 2
        }
        0xA8 => {
            cpu.y = cpu.a
            setZN(&mut cpu, cpu.y)
            cpu.cyc = cpu.cyc + 2
        }
        0x8A => {
            cpu.a = cpu.x
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 2
        }
        0x98 => {
            cpu.a = cpu.y
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 2
        }
        0xBA => {
            cpu.x = cpu.sp
            setZN(&mut cpu, cpu.x)
            cpu.cyc = cpu.cyc + 2
        }
        0x9A => {
            cpu.sp = cpu.x
            cpu.cyc = cpu.cyc + 2
        }
        // ---- stack ----
        0x48 => {
            push8(&mut cpu, &mut bus, cpu.a)
            cpu.cyc = cpu.cyc + 3
        }
        0x68 => {
            let v = pop8(&mut cpu, &mut bus)
            cpu.a = v
            setZN(&mut cpu, v)
            cpu.cyc = cpu.cyc + 4
        }
        0x08 => {
            push8(&mut cpu, &mut bus, cpu.p | FB | FU)
            cpu.cyc = cpu.cyc + 3
        }
        0x28 => {
            let v = pop8(&mut cpu, &mut bus)
            cpu.p = (v & (~FB)) | FU
            cpu.cyc = cpu.cyc + 4
        }
        // ---- logic ----
        0x29 => {
            let v = busRead(&mut bus, aImm(&mut cpu))
            cpu.a = cpu.a & v
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 2
        }
        0x25 => {
            let v = busRead(&mut bus, aZp(&mut cpu, &mut bus))
            cpu.a = cpu.a & v
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 3
        }
        0x35 => {
            let v = busRead(&mut bus, aZpX(&mut cpu, &mut bus))
            cpu.a = cpu.a & v
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 4
        }
        0x2D => {
            let v = busRead(&mut bus, aAbs(&mut cpu, &mut bus))
            cpu.a = cpu.a & v
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 4
        }
        0x3D => {
            let v = busRead(&mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.a = cpu.a & v
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        0x39 => {
            let v = busRead(&mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.a = cpu.a & v
            setZN(&mut cpu, cpu.a)
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        0x21 => {
            let v = busRead(&mut bus, aIndX(&mut cpu, &mut bus))
            cpu.a = cpu.a & v
