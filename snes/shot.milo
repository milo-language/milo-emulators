// Headless renderer: run a SNES ROM for N frames with no input, dump the frame as raw
// RGB24 (256x224). With [count], dump `count` consecutive frames back to back in one
// file, which ffmpeg reads as a video:
//   ffmpeg -f rawvideo -pixel_format rgb24 -video_size 256x224 -framerate 60 -i out.rgb out.mp4
//   milo build snes/shot.milo -o /tmp/snesshot --release
//   /tmp/snesshot <rom> <frames> <out.rgb> [count]
// No dspGenerate: the S-DSP voice state it advances is audio-only (the SPC700 never
// reads it back), so skipping synthesis does not change timing.
from "std/args" import {
    args
}
from "std/fs" import {
    writeFile
}
from "./cartcore" import {
    Cart
}
from "./cartridge" import {
    loadCartridge
}
from "./cpu" import {
    Cpu, Mem, busNew, newCpuReset, stepFrame
}
from "./ppu" import {
    renderFrame
}

let SNES_W: i64 = 256
let SNES_H: i64 = 224

fn main(): i32 {
    let argv = args()
    if argv.len < 4 {
        print("usage: shot <rom> <frames> <out.rgb> [count]")
        return 1
    }
    match loadCartridge(argv[1]) {
        Result.Ok(cart) => {
            var count: i64 = 1
            if argv.len > 4 {
                count = strToInt(argv[4])
            }
            return run(cart, strToInt(argv[2]), argv[3], count)
        }
        Result.Err(e) => {
            print("load failed: " + e)
            return 1
        }
    }
}

fn strToInt(s: string): i64 {
    var n: i64 = 0
    for ch in s {
        let c = ch as i64
        if c >= 48 && c <= 57 {
            n = n * 10 + (c - 48)
        }
    }
    return n
}

fn appendFrame(m: &Mem, fb: &mut Vec<i64>, data: &mut string): void {
    renderFrame(m.ppu, &mut fb)
    var i: i64 = 0
    while i < SNES_W * SNES_H {
        let px = fb[i]
        data.push(((px >> 16) & 0xFF) as u8)
        data.push(((px >> 8) & 0xFF) as u8)
        data.push((px & 0xFF) as u8)
        i = i + 1
    }
}

fn run(cart: Cart, frames: i64, out: string, count: i64): i32 {
    var m = busNew(cart.rom, cart.map)
    var cpu = newCpuReset(m)
    var fb: Vec<i64> = Vec.new()
    var i: i64 = 0
    while i < SNES_W * SNES_H {
        fb.push(0)
        i = i + 1
    }

    var f: i64 = 0
    while f < frames {
        stepFrame(&mut cpu, &mut m)
        f = f + 1
    }
    var data: string = ""
    appendFrame(m, &mut fb, &mut data)
    var done: i64 = 1
    while done < count {
        stepFrame(&mut cpu, &mut m)
        appendFrame(m, &mut fb, &mut data)
        done = done + 1
    }
    match writeFile(out, data) {
        Result.Ok(n) => {
            print("wrote bytes: ")
            print(n)
            return 0
        }
        Result.Err(e) => {
            print("write failed")
            return 1
        }
    }
}
