        // ---- LAX (load A and X) ----
        0xA7 => {
            lax(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 3
        }
        0xB7 => {
            lax(&mut cpu, &mut bus, aZpY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 4
        }
        0xAF => {
            lax(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 4
        }
        0xBF => {
            lax(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        0xA3 => {
            lax(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0xB3 => {
            lax(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5 + cpu.extraCycles
        }
        // ---- SAX (store A & X) ----
        0x87 => {
            sax(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 3
        }
        0x97 => {
            sax(&mut cpu, &mut bus, aZpY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 4
        }
        0x8F => {
            sax(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 4
        }
        0x83 => {
            sax(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        // ---- unofficial SBC (== official SBC imm) ----
        0xEB => {
            let v = busRead(&mut bus, aImm(&mut cpu))
            sbc(&mut cpu, v)
            cpu.cyc = cpu.cyc + 2
        }
        // ---- DCP (DEC + CMP) — RMW, fixed cycles (no page-cross add) ----
        0xC7 => {
            dcp(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0xD7 => {
            dcp(&mut cpu, &mut bus, aZpX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0xCF => {
            dcp(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0xDF => {
            dcp(&mut cpu, &mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0xDB => {
            dcp(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0xC3 => {
            dcp(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        0xD3 => {
            dcp(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        // ---- ISB/ISC (INC + SBC) ----
        0xE7 => {
            isb(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0xF7 => {
            isb(&mut cpu, &mut bus, aZpX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0xEF => {
            isb(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0xFF => {
            isb(&mut cpu, &mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0xFB => {
            isb(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0xE3 => {
            isb(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        0xF3 => {
            isb(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        // ---- SLO (ASL + ORA) ----
        0x07 => {
            slo(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0x17 => {
            slo(&mut cpu, &mut bus, aZpX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x0F => {
            slo(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x1F => {
            slo(&mut cpu, &mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x1B => {
            slo(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x03 => {
            slo(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        0x13 => {
            slo(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        // ---- RLA (ROL + AND) ----
        0x27 => {
            rla(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0x37 => {
            rla(&mut cpu, &mut bus, aZpX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x2F => {
            rla(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x3F => {
            rla(&mut cpu, &mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x3B => {
            rla(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x23 => {
            rla(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        0x33 => {
            rla(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        // ---- SRE (LSR + EOR) ----
        0x47 => {
            sre(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0x57 => {
            sre(&mut cpu, &mut bus, aZpX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x4F => {
            sre(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x5F => {
            sre(&mut cpu, &mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x5B => {
            sre(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x43 => {
            sre(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        0x53 => {
            sre(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        // ---- RRA (ROR + ADC) ----
        0x67 => {
            rra(&mut cpu, &mut bus, aZp(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0x77 => {
            rra(&mut cpu, &mut bus, aZpX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x6F => {
            rra(&mut cpu, &mut bus, aAbs(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x7F => {
            rra(&mut cpu, &mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x7B => {
            rra(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 7
        }
        0x63 => {
            rra(&mut cpu, &mut bus, aIndX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        0x73 => {
            rra(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 8
        }
        // ---- unofficial: immediate ALU ----
        0x0B => { // ANC
            anc(&mut cpu, busRead(&mut bus, aImm(&mut cpu)))
            cpu.cyc = cpu.cyc + 2
        }
        0x2B => { // ANC (mirror)
            anc(&mut cpu, busRead(&mut bus, aImm(&mut cpu)))
            cpu.cyc = cpu.cyc + 2
        }
        0x4B => { // ALR / ASR
            alr(&mut cpu, busRead(&mut bus, aImm(&mut cpu)))
            cpu.cyc = cpu.cyc + 2
        }
        0x6B => { // ARR
            arr(&mut cpu, busRead(&mut bus, aImm(&mut cpu)))
            cpu.cyc = cpu.cyc + 2
        }
        0xCB => { // SBX / AXS
            sbx(&mut cpu, busRead(&mut bus, aImm(&mut cpu)))
            cpu.cyc = cpu.cyc + 2
        }
        0xAB => { // LXA / LAX #imm
            lxa(&mut cpu, busRead(&mut bus, aImm(&mut cpu)))
            cpu.cyc = cpu.cyc + 2
        }
        0x8B => { // ANE / XAA
            ane(&mut cpu, busRead(&mut bus, aImm(&mut cpu)))
            cpu.cyc = cpu.cyc + 2
        }
        // ---- unofficial: LAS (read), SH* / TAS (unstable stores) ----
        0xBB => { // LAS
            las(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 4 + cpu.extraCycles
        }
        0x9F => { // SHA abs,Y
            sha(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0x93 => { // SHA (ind),Y
            sha(&mut cpu, &mut bus, aIndY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 6
        }
        0x9E => { // SHX abs,Y
            shx(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0x9C => { // SHY abs,X
            shy(&mut cpu, &mut bus, aAbsX(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        0x9B => { // TAS / SHS
            tas(&mut cpu, &mut bus, aAbsY(&mut cpu, &mut bus))
            cpu.cyc = cpu.cyc + 5
        }
        // ---- JAM / KIL: a real 6502 locks up until reset. Freeze on the opcode
        // (rewind the fetch) so PC stalls like hardware; the frame loop still
        // advances via NMI, keeping the emulator responsive to reset/game-switch.
        0x02 => {
            jam(&mut cpu)
        }
        0x12 => {
            jam(&mut cpu)
        }
        0x22 => {
            jam(&mut cpu)
        }
        0x32 => {
            jam(&mut cpu)
        }
        0x42 => {
            jam(&mut cpu)
        }
        0x52 => {
            jam(&mut cpu)
        }
        0x62 => {
            jam(&mut cpu)
        }
        0x72 => {
            jam(&mut cpu)
        }
        0x92 => {
            jam(&mut cpu)
        }
        0xB2 => {
            jam(&mut cpu)
        }
        0xD2 => {
            jam(&mut cpu)
        }
        0xF2 => {
            jam(&mut cpu)
        }
        _ => {
            // Every 8-bit pattern is now decoded (official + all undocumented).
            // Reaching here means a genuine dispatch gap — log once, skip, run on.
            if !cpu.unknownSeen[op as i64] {
                cpu.unknownSeen[op as i64] = true
                eprint("unimplemented opcode 0x" + hex2(op as i64) + " at pc=0x" + hex4((cpu.pc as i64 - 1) & 0xFFFF))
            }
            cpu.cyc = cpu.cyc + 2
        }
    }
}
